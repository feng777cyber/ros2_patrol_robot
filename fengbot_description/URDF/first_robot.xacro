<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="first_robot">
    <xacro:macro name='base_link' params='length radius'>  
    <!-- 机器人身体 -->
    <link name="base_link">
        <!---配件描述 -->
        <visual>
            <!-- 偏移and旋转 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <!-- 圆柱体 -->
                <cylinder radius="${radius}" length="${length}" />

            </geometry>
            <!-- 材质描述 -->
            <material name="white">
                <color rgba="1.0 1.0 1.0 0.5" />
            </material>
        </visual>


    </link>

    </xacro:macro>
    <xacro:macro name='imu_link' params='imu_name xyz'>  

    <!-- 机器人IMU -->
    <link name="${imu_name}">
        <!---配件描述 -->
        <visual>
            <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <box size="0.02 0.02 0.02" />

            </geometry>
            <!-- 材质描述 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 0.5" />
            </material>
        </visual>

    </link>
    <!-- 机器人关节——连接部件 -->
    <joint name="${imu_name}_joint" type="fixed">
        <parent link="base_link" />

        <child link="${imu_name}" />
        <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />

    </joint>
    </xacro:macro>
    <xacro:base_link length="0.12" radius="0.10" />
    <xacro:imu_link imu_name="imu_up" xyz="0.0 0.0 0.03" />
    <xacro:imu_link imu_name="imu_down1" xyz="0.0 0.0 -0.03" />
    <xacro:imu_link imu_name="imu_down2" xyz="0.0 0.0 -0.05" />
    <xacro:imu_link imu_name="imu_down3" xyz="0.0 0.0 -0.07" />
    <xacro:imu_link imu_name="imu_down4" xyz="0.0 0.0 -0.09" />
    <xacro:imu_link imu_name="imu_down5" xyz="0.0 0.0 -0.1" />


</robot>