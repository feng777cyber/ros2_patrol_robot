<?xml version="1.0"?>
<robot name="first_robot">

    <!-- 机器人身体 -->
    <link name="base_link">
        <!---配件描述 -->
        <visual>
            <!-- 偏移and旋转 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <!-- 圆柱体 -->
                <cylinder radius="0.10" length="0.12" />

            </geometry>
            <!-- 材质描述 -->
            <material name="white">
                <color rgba="1.0 1.0 1.0 0.5" />
            </material>
        </visual>


    </link>
    <!-- 机器人IMU -->
    <link name="imu_link">
        <!---配件描述 -->
        <visual>
            <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <box size="0.02 0.02 0.02" />

            </geometry>
            <!-- 材质描述 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 0.5" />
            </material>
        </visual>

    </link>
    <!-- 机器人关节——连接部件 -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />

        <child link="imu_link" />
        <origin xyz="0.0 0.0 0.03" rpy="0.0 0.0 0.0" />

    </joint>

</robot>