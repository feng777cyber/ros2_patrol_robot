<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:include filename="$(find fengbot_description)/URDF/fengbot/common_inertia.xacro"/>
    <!-- 机器人轮子 -->
     <xacro:macro name='wheel_xacro' params='wheel_name xyz'>  
    <link name="${wheel_name}_link">
        <!---配件描述 -->
        <visual>
            <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <cylinder radius="0.032" length="0.02" />
            </geometry>
            <!-- 材质描述 -->
            <material name="blue">
                <color rgba="0.0 0.0 1.0 0.8" />
            </material>
        </visual>
        <collision>
             <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <cylinder radius="0.032" length="0.02" />
            </geometry>
            <!-- 材质描述 -->
            <material name="blue">
                <color rgba="0.0 0.0 1.0 0.8" />
            </material>
           
        </collision>
         <xacro:cylinder_inertia m="0.05" r="0.032" h="0.02" />

    </link>
    <!-- 机器人关节——连接部件 -->
    <joint name="${wheel_name}_joint" type="continuous">
        <parent link="base_link" />

        <child link="${wheel_name}_link" />
        <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />
        <axis xyz="0.0 1.0 0.0"/>

    </joint>
    <gazebo reference="${wheel_name}_link">
        <mu1 value="20.0"/> 
        <mu2 value="20.0"/>
        <kp value="1000000000.0"/>
        <kd value="20.0"/>
        <!-- 1切向，2法向摩擦系数，刚度系数默认十个0，阻尼系数 -->
    </gazebo>
    </xacro:macro>

</robot>