<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
       <xacro:include filename="$(find fengbot_description)/URDF/fengbot/common_inertia.xacro"/>
    <!-- 机器人IMU -->
     <xacro:macro name='caster_xacro' params='caster_name xyz'>  
    <link name="${caster_name}_link">
        <!---配件描述 -->
        <visual>
            <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <sphere radius="0.016"/>
            </geometry>
            <!-- 材质描述 -->
            <material name="blue">
                <color rgba="0.0 0.0 1.0 0.8" />
            </material>
        </visual>
        <collision>
            <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <sphere radius="0.016"/>
            </geometry>
            <!-- 材质描述 -->
            <material name="blue">
                <color rgba="0.0 0.0 1.0 0.8" />
            </material>
        </collision>
        <xacro:sphere_inertia m="0.05" r="0.016" />

    </link>
    <!-- 机器人关节——连接部件 -->
    <joint name="${caster_name}_joint" type="fixed">
        <parent link="base_link" />

        <child link="${caster_name}_link" />
        <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />
        <axis xyz="0.0 1.0 0.0"/>

    </joint>



     <gazebo reference="${caster_name}_link">
        <mu1 value="0.0"/> 
        <mu2 value="0.0"/>
        <kp value="1000000000.0"/>
        <kd value="1.0"/>
        <!-- 1切向，2法向摩擦系数，刚度系数默认十个0，阻尼系数 -->
    </gazebo>

    </xacro:macro>
    




</robot>