<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
       <xacro:include filename="$(find fengbot_description)/URDF/fengbot/common_inertia.xacro"/>
 
    <!-- 机器人IMU -->
     <xacro:macro name='imu_xacro' params=' xyz'>  
    <link name="imu_link">
        <!---配件描述 -->
        <visual>
            <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <box size="0.02 0.02 0.02" />

            </geometry>
            <!-- 材质描述 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 0.5" />
            </material>
        </visual>

        <collision>
             <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <box size="0.02 0.02 0.02" />

            </geometry>
            <!-- 材质描述 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 0.5" />
            </material>
        </collision>
        <xacro:box_inertia m="0.05" w="0.02" h="0.02" d="0.02" />

    </link>
    <!-- 机器人关节——连接部件 -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />

        <child link="imu_link" />
        <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />

    </joint>
    </xacro:macro>




</robot>