<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
       <xacro:include filename="$(find fengbot_description)/URDF/fengbot/common_inertia.xacro"/>

    <!-- 机器人激光雷达 -->
    <xacro:macro name='laser_xacro' params=' xyz'>
        <link name="laser_link">
            <!---配件描述 -->
            <visual>
                <!-- 自身几何中心的旋转偏移量 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <!-- 形状描述 -->
                <geometry>
                    <cylinder radius="0.02" length="0.02" />


                </geometry>
                <!-- 材质描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.5" />
                </material>
            </visual>
             <collision>
            <!-- 自身几何中心的旋转偏移量 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <!-- 形状描述 -->
            <geometry>
                <cylinder radius="0.02" length="0.02" />


            </geometry>
            <!-- 材质描述 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 0.5" />
            </material>

    
        </collision>



        <xacro:cylinder_inertia m="0.10" r="0.02" h="0.02" />
               </link>
        
        <!-- 机器人激光雷达支撑杆 -->
        <link name="laser_link_cylinder">
            <!---配件描述 -->
            <visual>
                <!-- 自身几何中心的旋转偏移量 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <!-- 形状描述 -->
                <geometry>
                    <cylinder radius="0.01" length="0.10" />

                </geometry>
                <!-- 材质描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0" />
                </material>
            </visual>
            <collision>
                  <!-- 自身几何中心的旋转偏移量 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <!-- 形状描述 -->
                <geometry>
                    <cylinder radius="0.02" length="0.10" />

                </geometry>
                <!-- 材质描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0" />
                </material>
                
            </collision>

            <xacro:cylinder_inertia m="0.05" r="0.01" h="0.10" />
        </link>
        <!-- 机器人关节——连接部件 -->
        <joint name="laser_joint" type="fixed">
            <parent link="laser_link_cylinder" />

            <child link="laser_link" />
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0" />

        </joint>
        <joint name="laser_cylinder_joint" type="fixed">
            <parent link="base_link" />

            <child link="laser_link_cylinder" />
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />

        </joint>
    </xacro:macro>
    <gazebo reference="laser_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="laser_link_cylinder">
        <material>Gazebo/Black</material>
    </gazebo>


</robot>